# mcp-gway container environment — copy to `.env` and adjust (never commit a
# real `.env` with credentials; OPS-04 / DENY-13).
#
# The container binds 0.0.0.0 so the published host port is reachable. The
# gateway exits 2 on a non-loopback bind unless this is set, so it is required
# for every compose profile below.

# Optional: host port published for the gateway's HTTP transport (default 8080).
MCP_GWAY_PORT=8080

# Required: opt-in to binding a non-loopback address (0.0.0.0) in the container.
MCP_GWAY_ALLOW_REMOTE=1

# Optional: log verbosity (trace|debug|info|warning|error|critical).
MCP_GWAY_LOG_LEVEL=info

# Optional: cap on bytes a Code Mode result may return to an agent. Empty = default.
MCP_GWAY_MAX_RESULT_BYTES=

# Optional: comma-separated allow-list of local commands Code Mode may run.
# Leave unset for the built-in safe default. Never use "*" or bare paths.
MCP_GWAY_ALLOW_LOCAL_COMMANDS=

# Optional (prod only): digest-pinned image to deploy, e.g.
#   MCP_GWAY_IMAGE=ghcr.io/deuriib/mcp-gway:6.1.1@sha256:<digest>
# Defaults to mcp-gway:local (what `mise run docker:build` produces).
MCP_GWAY_IMAGE=
